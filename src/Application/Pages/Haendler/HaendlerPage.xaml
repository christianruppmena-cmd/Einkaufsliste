<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Einkaufsliste.HaendlerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Einkaufsliste.Converters"
    Title="Händlerverwaltung"
    BackgroundColor="#F4F7F5">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BooleanToStatusConverter
                         x:Key="BooleanToStatusConverter"/>
            <converters:BooleanToStatusColorConverter
                         x:Key="BooleanToStatusColorConverter"/>
            <converters:StringNullOrEmptyConverter
                         x:Key="StringNullOrEmptyConverter"/>

            <converters:InvertedStringNullOrEmptyConverter
                         x:Key="InvertedStringNullOrEmptyConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="20">

        <!-- Überschrift -->
        <VerticalStackLayout Grid.Row="0" Spacing="5">

            <Label
                Text="Händlerverwaltung"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#1B5E43"/>

            <Label
                Text="Verwalte deine Supermärkte und Händler."
                FontSize="14"
                TextColor="Gray"/>

        </VerticalStackLayout>

        <!-- Händler hinzufügen -->
        <Button
            Grid.Row="1"
            Text="+ Händler hinzufügen"
            BackgroundColor="#1B5E43"
            TextColor="White"
            CornerRadius="12"
            HeightRequest="50"
            FontAttributes="Bold"
            Clicked="OnHaendlerHinzufuegenClicked"/>

        <!-- Händlerliste -->
        <CollectionView
            Grid.Row="2"
            x:Name="HaendlerListe"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="10">

                    <Label
                        Text="Noch keine Händler vorhanden."
                        FontSize="16"
                        TextColor="Gray"
                        HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        BackgroundColor="White"
                        Stroke="#E0E7E2"
                        StrokeThickness="1"
                        Padding="15"
                        Margin="0,0,0,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>

                        <Grid
                            ColumnDefinitions="65,*,Auto"
                            ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnHaendlerAngeklickt"/>
                            </Grid.GestureRecognizers>
                            <!-- Händlerlogo -->
                            <Border
                                Grid.Column="0"
                                WidthRequest="55"
                                HeightRequest="55"
                                BackgroundColor="#F4F7F5"
                                StrokeThickness="0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Grid>
                                    <!--Standard Logo Symbol-->
                                    <Image
                                        Source="shop_placeholder.svg"
                                        Aspect="AspectFit"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding LogoPfad, Converter={StaticResource InvertedStringNullOrEmptyConverter}}"/>
                                        
                                    <!--Händler Logo-->
                                    <Image
                                        Source="{Binding LogoPfad}"
                                        Aspect="AspectFit"
                                        Margin="5"
                                        IsVisible="{Binding LogoPfad, Converter={StaticResource StringNullOrEmptyConverter}}"/>
                                </Grid>


                            </Border>

                            <!-- Händlername -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center">   

                                <Label
                                    Text="{Binding Name}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="#26352C"/>

                                

                            </VerticalStackLayout>

                            <!-- Status -->
                            <Label
                                Grid.Column="2"
                                Text="{Binding IstAktiv, Converter={StaticResource BooleanToStatusConverter }}"
                                TextColor="{Binding IstAktiv, Converter={StaticResource BooleanToStatusColorConverter }}"
                                FontSize="12"
                                VerticalOptions="Center"/>

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>