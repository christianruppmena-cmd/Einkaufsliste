<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Einkaufsliste.ArtikelEingabePage"
             Title="ArtikelEingabePage">
    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="18">
            
            <Label
                Text="Neuer Artikel"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#1B5E43" />
            <Label
                Text="Artikelname"
                FontAttributes="Bold"/>

            <Entry
                x:Name="ArtikelNameEingabe"
                Placeholder="z. B. Milch"
                ClearButtonVisibility="WhileEditing"
                BackgroundColor="White"/>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12">
                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="8">
                    
                    <Label
                        Text="Menge"
                        FontAttributes="Bold"/>
                    
                    <Entry
                        x:Name="MengeEingabe"
                        Placeholder="z. B. 2"
                        Text="1"
                        Keyboard="Numeric"
                        BackgroundColor="White"/>
                
                </VerticalStackLayout>
                <VerticalStackLayout 
                    Grid.Column="1"
                    Spacing="8">
                    
                    <Label
                        Text="Einheit"
                        FontAttributes="Bold"/>
                    
                    <Picker
                        x:Name="EinheitAuswahl"
                        Title="Einheit wählen"
                        BackgroundColor="White">
                       
                        <Picker.Items>
                            <x:String>Stück</x:String>
                            <x:String>Packung</x:String>
                            <x:String>Flasche</x:String>
                            <x:String>Gramm</x:String>
                            <x:String>Kilogramm</x:String>
                            <x:String>Milliliter</x:String>
                            <x:String>Liter</x:String>
                            <x:String>Beutel</x:String>
                            <x:String>Dose</x:String>
                            <x:String>Glas</x:String>
                        </Picker.Items>
                    </Picker>

                </VerticalStackLayout>

            </Grid>
            
            <Label
                Text="Details / Hinweis (optional)"
                FontAttributes="Bold"/>
            
            <Editor
                x:Name="DetailsEingabe"
                Placeholder="z. B. Fettarm, Marke oder Sortre"
                AutoSize="TextChanges"
                MinimumHeightRequest="100"
                BackgroundColor="White"/>
            
            <Button 
                x:Name="HinzufügenButton"
                Text="Artikel hinzufügen"
                BackgroundColor="#1B5E43"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="52"
                Clicked="OnHinzufuegenClicked"/>
            
            <Button
                Text="Abbrechen"
                BackgroundColor="Transparent"
                TextColor="#1B5E43"
                CornerRadius="12"
                HeightRequest="52"
                Clicked="OnAbbrechenClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>