<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Einkaufsliste.ProduktpreisePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Preisverwaltung"
    BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                x:Name="ProduktNameLabel"
                Text="Produktname"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#245C43"/>

            <Label
                Text="Händlerpreise"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#245C43"/>

            <CollectionView
                x:Name="HaendlerPreisListe"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label
                        Text="Für dieses Produkt sind noch keine Preise hinterlegt."
                        TextColor="Gray"
                        HorizontalOptions="Center"
                        Margin="10"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BackgroundColor="White"
                            Stroke="#D8E5DC"
                            StrokeThickness="1"
                            Padding="14"
                            Margin="0,5"
                            StrokeShape="RoundRectangle 12">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="{Binding Haendler}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="#245C43"/>

                                <Label
                                    Text="{Binding Normalpreis, StringFormat='Normalpreis: {0}'}"
                                    TextColor="#333333"/>

                                <Label
                                    Text="{Binding Angebot, StringFormat='Angebot: {0}'}"
                                    TextColor="#245C43"/>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <BoxView
                HeightRequest="1"
                BackgroundColor="#D8E5DC"
                Margin="0,10"/>

            <Label
                Text="Preis erfassen"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="#245C43"/>

            <Label
                Text="Händler"
                TextColor="#222222"/>

            <Picker
                x:Name="HaendlerPicker"
                Title="Händler auswählen"
                TextColor="#222222"/>

            <Label
                Text="Preisart"
                TextColor="#222222"/>

            <Picker
                x:Name="PreisartPicker"
                Title="Preisart auswählen"
                TextColor="#222222">
                <Picker.Items>
                    <x:String>Normalpreis</x:String>
                    <x:String>Angebot</x:String>
                </Picker.Items>
            </Picker>

            <Label
                Text="Preis in Euro"
                TextColor="#222222"/>

            <Entry
                x:Name="PreisEntry"
                Placeholder="z. B. 1,29"
                Keyboard="Numeric"
                TextColor="#222222"/>

            <Label
                Text="Gültig von"
                TextColor="#222222"/>

            <DatePicker
                x:Name="GueltigVonPicker"
                Format="dd.MM.yyyy"/>

            <Label
                Text="Gültig bis (optional)"
                TextColor="#222222"/>

            <CheckBox
                x:Name="GueltigBisAktivieren"
                CheckedChanged="OnGueltigBisAktivierenChanged"/>
            <Label
                Text="Enddatum festlegen"
                TextColor="#222222"/>

            <DatePicker
                x:Name="GueltigBisPicker"
                Format="dd.MM.yyyy"/>

            <Button
                Text="Preis speichern"
                BackgroundColor="#245C43"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="OnPreisSpeichernClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>