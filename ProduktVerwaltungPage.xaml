<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Einkaufsliste.ProduktverwaltungPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Produktverwaltung"
    BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="Neues Produkt"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#245C43"/>

            <Label 
                Text="Produktname *"
                TextColor="#222222"/>
            <Entry
                x:Name="NameEntry"
                Placeholder="z. B. Milch"
                TextColor="#222222"
                />

            <Label 
                Text="Marke"
                TextColor="#222222"/>
            <Entry
                x:Name="MarkeEntry"
                Placeholder="z. B. Milbona"
                TextColor="#222222"/>

            <Label 
                Text="Variante"
                TextColor="#222222"/>
            <Entry
                x:Name="VarianteEntry"
                Placeholder="z. B. H-Milch 3,5 %"
                TextColor="#222222"/>

            <Label 
                Text="Kategorie *"
                   TextColor="#222222"/>
            <Picker
                x:Name="KategoriePicker"
                Title="Kategorie auswählen"
                TextColor="#222222"/>

            <Label 
                Text="Packungsgröße"
                TextColor="#222222"/>
            <Entry
                x:Name="PackungsgroesseEntry"
                Placeholder="z. B. 1000"
                Keyboard="Numeric"
                TextColor="#222222"/>

            <Label 
                Text="Basiseinheit"
                TextColor="#222222"/>
            <Picker
                x:Name="BasiseinheitPicker"
                Title="Einheit auswählen"
                TextColor="#222222">
                <Picker.Items>
                    <x:String>g</x:String>
                    <x:String>kg</x:String>
                    <x:String>ml</x:String>
                    <x:String>l</x:String>
                    <x:String>Stück</x:String>
                </Picker.Items>
            </Picker>

            <Button
                Text="Produktbild verwalten"
                HeightRequest="48"
                CornerRadius="10"
                TextColor="#E8F1EB"
                BackgroundColor="#245C43"
                Clicked="OnProduktbildVerwaltenClicked"/>

            <Button
                Text="Produkt speichern"
                HeightRequest="52"
                CornerRadius="12"
                TextColor="#E8F1EB"
                BackgroundColor="#245C43"
                Clicked="OnProduktSpeichernClicked"/>

            <BoxView
                HeightRequest="1"
                BackgroundColor="#D8E5DC"
                Margin="0,10"/>

            <Label
                Text="Gespeicherte Produkte"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="#245C43"/>

            <CollectionView
                x:Name="ProduktListe"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label
                        Text="Noch keine Produkte vorhanden."
                        TextColor="Gray"
                        HorizontalOptions="Center"
                        Margin="10"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BackgroundColor="White"
                            Stroke="#D8E5DC"
                            StrokeThickness="1"
                            Padding="14"
                            Margin="0,5"
                            StrokeShape="RoundRectangle 12">

                            <Grid ColumnDefinitions="75,*" ColumnSpacing="12">

                                <Border
                                    Grid.Column="0"
                                    WidthRequest="75"
                                    HeightRequest="75"
                                    BackgroundColor="#E8F1EB"
                                    Stroke="#D8E5DC"
                                    StrokeShape="RoundRectangle 10">

                                    <Image
                                        Source="{Binding BildPfad}"
                                        Aspect="AspectFill"
                                        HeightRequest="75"
                                        WidthRequest="75"/>
                                </Border>

                                <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="5">

                                    <Label
                                        Text="{Binding Name}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="#245C43"/>

                                    <Label
                                        Text="{Binding Marke}"
                                        FontSize="14"
                                        TextColor="#555555"/>

                                    <Label
                                        Text="{Binding Variante}"
                                        FontSize="14"
                                        TextColor="#555555"/>

                                    <Label
                                        Text="{Binding Kategorie}"
                                        FontSize="13"
                                        TextColor="#777777"/>

                                    <Button
                                        Text="Bearbeiten"
                                        BackgroundColor="#E8F1EB"
                                        TextColor="#245C43"
                                        CornerRadius="10"
                                        HeightRequest="42"
                                        HorizontalOptions="End"
                                        Clicked="OnProduktBearbeitenClicked"/>
                                    <Button 
                                        Text="Preise verwalten"
                                        BackgroundColor="#E8F1EB"
                                        TextColor="#245C43"
                                        CornerRadius="10"
                                        HeightRequest="42"
                                        HorizontalOptions="End"
                                        Clicked="OnPreiseVerwaltenClicked"/>

                                </VerticalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>