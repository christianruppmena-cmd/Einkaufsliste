<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Einkaufsliste.MainPage"
             Title="Einkaufsliste"
             BackgroundColor="#F4F7F5">
    <Grid Padding="20">



        <!-- Einkaufsliste -->
        <CollectionView
                x:Name="ArtikelListe"
                IsGrouped="True"
                SelectionMode="None"
                VerticalOptions="Fill">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="16">
                    <!-- Überschrift -->
                    <Border    
                        
                        BackgroundColor="#1B5E43"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,10"
                        Margin="0,0,0,5">
                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="&#x1F6D2; Meine Einkaufsliste"
                                FontSize="21"
                                FontAttributes="Bold"
                                TextColor="White"                                
                                HorizontalTextAlignment="Center"/>
                                 
                            <Label
                                x:Name="ArtikelAnzahlText"
                                Text="0 Artikel insgesamt"
                                FontSize="12"
                                TextColor="#D5E9DD"
                                HorizontalTextAlignment="Center"
                                Margin="0,2,0,0"/>
                        </VerticalStackLayout>

                    </Border>


                    <Border    
                        
                        BackgroundColor="White"
                        Stroke="#E3EBE5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="12"
                        Margin="0,0,0,5">
                        <VerticalStackLayout Spacing="6">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    Text="Dein Fortschritt"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#26352C"
                                    VerticalOptions="Center"/>

                                <Label
                                    x:Name="FortschrittText"
                                    Grid.Column="1"
                                    Text="0 von 0 erledigt"
                                    FontSize="13"
                                    TextColor="#278653"
                                    VerticalOptions="Center"/>

                            </Grid>
                            <ProgressBar
                                x:Name="FortschrittBalken"
                                Progress="0"
                                ProgressColor="#278653"
                                BackgroundColor="#E3EBE5"
                                HeightRequest="6"/>                        

                            <Label
                                x:Name="GesamtsummeText"
                                Text="Gesamtsumme: 0,00 €"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#1B5E43"
                                HorizontalTextAlignment="End"
                                Margin="0,2,0,0"/>
                        </VerticalStackLayout>

                    </Border>

                    <!-- Hinzufügen-Button -->
                    <!-- Produktsuche -->
                    <VerticalStackLayout Spacing="0">

                        <Border
                            BackgroundColor="White"
                            Stroke="#DCE7DF"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12"
                            Margin="0,0,0,5">

                            <Grid ColumnDefinitions="Auto,*,44"
                                  ColumnSpacing="8">

                                <Label
                                    Text="&#x1F50D;"
                                    FontSize="20"
                                    VerticalOptions="Center"/>

                                <Entry
                                    x:Name="ProduktsucheEntry"
                                    Grid.Column="1"
                                    Placeholder="Produkt suchen ..."
                                    FontSize="16"
                                    TextChanged="OnProduktsucheTextChanged"
                                    ClearButtonVisibility="WhileEditing"/>
                                <Button
                                    Grid.Column="2"
                                    Text="+"
                                    FontSize="26"
                                    FontAttributes="Bold"
                                    BackgroundColor="#1B5E43"
                                    TextColor="White"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    CornerRadius="22"
                                    Padding="0"
                                    VerticalOptions="Center"
                                    Clicked="OnProduktNeuAnlegenClicked"/>
                            </Grid>
                        </Border>

                        <!-- Produktvorschläge -->
                        <Border
                            x:Name="ProduktVorschlaegeContainer"
                            IsVisible="False"
                            BackgroundColor="White"
                            Stroke="#E3EBE5"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="5"
                            Margin="0,0,0,10">

                            <CollectionView
                                x:Name="ProduktVorschlaegeListe"
                                SelectionMode="Single"
                                SelectionChanged="OnProduktVorschlagAusgewaehlt"
                                MaximumHeightRequest="250">

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="10"
                                              RowDefinitions="Auto,Auto"
                                              ColumnDefinitions="*">

                                            <Label
                                                Grid.Row="0"
                                                Text="{Binding Name}"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                TextColor="#222222"/>

                                            <Label
                                                Grid.Row="1"
                                                Text="{Binding Marke}"
                                                FontSize="12"
                                                TextColor="#64746A"/>

                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>

                            </CollectionView>
                        </Border>

                    </VerticalStackLayout>
                    <!-- Gruppierung der Einkaufsliste -->
                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="10"
                        Margin="0,0,0,5"
                        VerticalOptions="Center">

                        <Label
                            Grid.Column="0"
                            Text="Sortieren nach:"
                            FontSize="14"
                            TextColor="#26352C"
                            VerticalOptions="Center"/>

                        <Picker
                            x:Name="GruppierungsPicker"
                            Grid.Column="1"
                            Title="Auswählen"
                            FontSize="14"
                            BackgroundColor="White"
                            TextColor="#26352C"
                            HeightRequest="42"
                            SelectedIndexChanged="OnGruppierungGeaendert">

                            <Picker.Items>
                                <x:String>Produktkategorie</x:String>
                                <x:String>Kaufort</x:String>
                            </Picker.Items>

                        </Picker>

                    </Grid>

                    <Grid              
                        ColumnDefinitions="*,Auto">

                        <!-- Liste der Artikel -->
                        <Label
                            Grid.Column="0"
                            Text="Deine Artikel"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#222222"
                            VerticalOptions="Center"/>
                      
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <VerticalStackLayout
                        Padding="20"
                        Spacing="12"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                    <Label
                            Text="&#x1F6D2;"
                            FontSize="48"
                            HorizontalTextAlignment="Center"/>

                    <Label
                            Text="Deine Liste ist noch leer"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#26352C"
                            HorizontalTextAlignment="Center" />

                    <Label
                            Text="Was brauchst du heute? Füge deinen erstel Artikel hinzu! "
                            FontSize="14"
                            TextColor="#89968E"
                            HorizontalTextAlignment="Center"
                            HorizontalOptions="Center"
                            LineBreakMode="WordWrap" />

                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <!-- Kategorie Überschrift-->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Border
                            BackgroundColor="#245B3D"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,10"
                            Margin="0,12,0,4">

                        <Label
                                Text="{Binding Ueberschrift}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="White"
                                />

                    </Border>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
            BackgroundColor="White"
            Stroke="#E3EBE5"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 16"
            Padding="12"
            Margin="0,5">

                        <Grid
                RowDefinitions="Auto,Auto,Auto"
                ColumnDefinitions="48,*,44"
                RowSpacing="8"
                ColumnSpacing="6">

                            <!-- Checkbox -->
                            <CheckBox
                    Grid.Row="0"
                    Grid.Column="0"
                    IsChecked="{Binding IstErledigt, Mode=TwoWay}"
                    CheckedChanged="OnArtikelErledigtGeaendert"
                    WidthRequest="48"
                    HeightRequest="48"
                    VerticalOptions="Center"
                    Color="#278653"/>

                            <!-- Produktname und Details -->
                            <VerticalStackLayout
                    Grid.Row="0"
                    Grid.Column="1"
                    Spacing="4"
                    VerticalOptions="Center">

                                <Label
                        Text="{Binding Name}"
                        FontSize="18"
                        TextColor="#222222"
                        LineBreakMode="WordWrap">

                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                Tapped="OnArtikelDetailsAnzeigenClicked"/>
                                    </Label.GestureRecognizers>

                                    <Label.Triggers>
                                        <DataTrigger
                                TargetType="Label"
                                Binding="{Binding IstErledigt}"
                                Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                            <Setter Property="TextColor" Value="Gray"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label
                        Text="{Binding HaendlerAnzeige, StringFormat='Kaufort: {0}'}"
                        FontSize="12"
                        TextColor="#3976A8"
                        LineBreakMode="WordWrap"/>
                                
                            </VerticalStackLayout>

                            <!-- Löschen -->
                            <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    Text="&#x1F5D1;"
                    BackgroundColor="#FFF0F0"
                    TextColor="#C62828"
                    FontSize="20"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0"
                    CommandParameter="{Binding .}"
                    Clicked="OnArtikelLoeschenClicked"
                    CornerRadius="12"
                    VerticalOptions="Center"/>

                            <!-- Mengensteuerung und Einheit -->
                            <Grid
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    ColumnDefinitions="40,110,*"
                    ColumnSpacing="10"
                    VerticalOptions="Center">

                                <!-- Menge -->
                                <Grid
                        Grid.Column="0"
                        RowDefinitions="16,28,16"
                        WidthRequest="40">

                                    <Button
                            Grid.Row="0"
                            Text="+"
                            FontSize="12"
                            Padding="0"
                            HeightRequest="16"
                            WidthRequest="36"
                            MinimumHeightRequest="16"
                            MinimumWidthRequest="36"
                            BackgroundColor="#E8F1EB"
                            TextColor="#3976A8"
                            CornerRadius="4"
                            Clicked="OnMengeErhoehenClicked"
                            CommandParameter="{Binding .}"/>

                                    <Entry
                            Grid.Row="1"
                            Text="{Binding Menge, Mode=TwoWay}"
                            Keyboard="Numeric"
                            WidthRequest="40"
                            HeightRequest="28"
                            FontSize="16"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextChanged="OnMengeGeaendert"
                            Margin="0"/>

                                    <Button
                            Grid.Row="2"
                            Text="−"
                            FontSize="12"
                            Padding="0"
                            HeightRequest="16"
                            WidthRequest="36"
                            MinimumHeightRequest="16"
                            MinimumWidthRequest="36"
                            BackgroundColor="#E8F1EB"
                            TextColor="#3976A8"
                            CornerRadius="4"
                            Clicked="OnMengeVerringernClicked"
                            CommandParameter="{Binding .}"/>
                                </Grid>

                                <!-- Einheit -->
                                <Picker
                        Grid.Column="1"
                        Title="Einheit"
                        SelectedItem="{Binding Einheit, Mode=TwoWay}"
                        SelectedIndexChanged="OnEinheitGeaendert"
                        FontSize="12"
                        WidthRequest="110"
                        HorizontalOptions="Start"
                        VerticalOptions="Center">

                                    <Picker.Items>
                                        <x:String>Stück</x:String>
                                        <x:String>Packung</x:String>
                                        <x:String>Flasche</x:String>
                                        <x:String>Kg</x:String>
                                        <x:String>g</x:String>
                                        <x:String>Liter</x:String>
                                        <x:String>ml</x:String>
                                        <x:String>100 g</x:String>
                                        <x:String>100 ml</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Grid>

                            <!-- Preise -->
                            <HorizontalStackLayout
                    Grid.Row="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Spacing="6"
                    VerticalOptions="Center">

                                <Label
                        Text="Stück / Gesamt:"
                        FontSize="12"
                        TextColor="#64746A"
                        VerticalOptions="Center"/>

                                <Label
                        Text="{Binding Stueckpreis, StringFormat='{0:N2} €'}"
                        FontSize="13"
                        TextColor="#64746A"
                        VerticalOptions="Center"/>

                                <Label
                        Text="/"
                        FontSize="13"
                        TextColor="#64746A"
                        VerticalOptions="Center"/>

                                <Label
                        Text="{Binding Gesamtpreis, StringFormat='{0:N2} €'}"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#1B5E43"
                        VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
        
    </Grid>



</ContentPage>
